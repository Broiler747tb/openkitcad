{
  "name": "openkitcad",
  "version": "1.0.0",
  "private": true,
  "description": "Open source parametric CAD for tinkerers, with a catalogue of real parts and boards.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src electron vite.config.ts",
    "dist:portable": "npm run build && electron-builder --win portable --x64",
    "android:apk": "npm run build && cd android && gradlew.bat assembleDebug"
  },
  "dependencies": {
    "comlink": "^4.4.2",
    "fflate": "^0.8.3",
    "opentype.js": "1.3.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "replicad": "^0.23.1",
    "replicad-opencascadejs": "^0.23.0",
    "three": "^0.185.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "prettier": "^3.9.6",
    "typescript": "~5.9.0",
    "vite": "^8.0.0"
  },
  "build": {
    "appId": "com.broiler747tb.openkitcad",
    "productName": "OpenKitCAD",
    "directories": {
      "output": "release-portable"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "OpenKitCAD-${version}-portable.${ext}"
    }
  }
}
